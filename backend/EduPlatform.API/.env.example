# Database Connection
ConnectionStrings__DefaultConnection=Host=YOUR_HOST;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require

# JWT Authentication
Jwt__Key=YOUR_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG

# Resend Email Service
Resend__ApiKey=re_YOUR_RESEND_API_KEY

# Optional: Override frontend URL if not using default
# FrontendBaseUrl=https://your-frontend-domain.com
